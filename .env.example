# TMDB Settings -> API -> "API Read Access Token" (the long one, not the shorter v3 API key).
TMDB_READ_TOKEN=

# Stripe Dashboard -> Developers -> API keys, test mode. Starts with sk_test_.
STRIPE_SECRET_KEY=

# Local MariaDB (docker-compose "db" service). Pick any values; they just need to
# match what config/config.php reads to connect. DB_HOST is the docker-compose
# service name, not localhost, since PHP connects to it over the compose network.
DB_HOST=db
DB_NAME=dwp_cinema
DB_USER=dwp
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Outgoing mail (PHPMailer over SMTP).
# MAIL_FROM is the sender, and MAIL_OWNER is where contact form messages are delivered.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=info@example.com
MAIL_PASSWORD=
MAIL_FROM=info@example.com
MAIL_OWNER=info@example.com # Set to my school email in production, go ahead and spam it, i don't care
