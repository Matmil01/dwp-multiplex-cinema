# TMDB Settings -> API -> "API Read Access Token" (the long one).
TMDB_READ_TOKEN=

# Stripe Dashboard -> Developers -> API keys, test mode. Starts with sk_test_.
STRIPE_SECRET_KEY=

# Local database. Pick any values.
DB_HOST=db
DB_NAME=dwp_cinema
DB_USER=dwp
DB_PASSWORD=
DB_ROOT_PASSWORD=

# MAIL_FROM is sender of email templates. MAIL_OWNER receives contact form messages.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=info@example.com
MAIL_PASSWORD=
MAIL_FROM=info@example.com
MAIL_OWNER=info@example.com # Set to my school email in production, go ahead and spam it, i don't care
